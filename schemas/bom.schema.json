{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOM",
  "type": "object",
  "required": ["board", "items"],
  "additionalProperties": false,
  "properties": {
    "board": {
      "type": "object",
      "required": ["type", "mcu", "supply"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "mcu": { "type": "string", "minLength": 1 },
        "supply": { "type": "string", "pattern": "^\\+?[0-9.]+V([0-9])?$" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "value", "footprint", "description", "qty"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "pattern": "^(R|C|L|Y|U|D|J|Q|SW|F)[0-9]+$" },
          "value": { "type": "string", "minLength": 1 },
          "footprint": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-]+:[A-Za-z0-9_.\\-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "qty": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      }
    }
  }
}
