{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Netlist",
  "type": "object",
  "required": ["nets"],
  "additionalProperties": false,
  "properties": {
    "nets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "pins"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(\\+[0-9.]+V[0-9]?|GND|[A-Z][A-Z0-9_]{1,23})$"
          },
          "pins": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["ref", "pin"],
              "additionalProperties": false,
              "properties": {
                "ref": { "type": "string", "pattern": "^(R|C|L|Y|U|D|J|Q|SW|F)[0-9]+$" },
                "pin": { "type": "string", "pattern": "^[0-9A-Za-z_.]+$" }
              }
            }
          }
        }
      }
    }
  }
}
